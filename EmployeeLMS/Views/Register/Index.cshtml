@model EmployeeLMS.DTO.RegistrationDTO
@{
    ViewData["Title"] = "Register";
}

<div class="d-flex align-items-center justify-content-center bg-light flex-grow-1 py-5">
    <div class="card shadow-sm border-0 rounded-4 p-4" style="width: 100%; max-width: 480px;">
        <div class="card-body">
            <h1 class="h3 fw-bold mb-1">Create Account</h1>
            <p class="text-muted mb-4">Join the Library Management System</p>

            <form asp-controller="Register" asp-action="Index" method="post" id="registerForm" novalidate>

                <div class="row mb-3">
                    <div class="col-md-6 mb-3 mb-md-0">
                        <label asp-for="FirstName" class="form-label">First Name</label>
                        <input asp-for="FirstName" class="form-control rounded-3" placeholder="Enter first name">
                        <div class="invalid-feedback">First name is required.</div>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="LastName" class="form-label">Last Name</label>
                        <input asp-for="LastName" class="form-control rounded-3" placeholder="Enter last name">
                        <div class="invalid-feedback">Last name is required.</div>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" class="form-control rounded-3" placeholder="Enter email">
                    <div class="invalid-feedback">Enter a valid email address.</div>
                </div>

                <div class="mb-3">
                    <label asp-for="PhoneNumber" class="form-label">Phone Number</label>
                    <input asp-for="PhoneNumber" class="form-control rounded-3" placeholder="Enter phone number">
                    <div class="invalid-feedback">Phone number is required.</div>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Password</label>
                    <input asp-for="Password" type="password" class="form-control rounded-3" placeholder="Create password">
                    <div class="form-text">Must be at least 8 characters long.</div>
                    <div class="invalid-feedback">Password must be at least 8 characters.</div>
                </div>

                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control rounded-3" placeholder="Re-enter password">
                    <div class="invalid-feedback">Passwords do not match.</div>
                </div>

                <div class="form-check mb-4">
                    <input class="form-check-input" type="checkbox" id="privacyPolicy" required>
                    <label class="form-check-label" for="privacyPolicy">
                        I agree to the <a asp-controller="Home" asp-action="Privacy" class="text-decoration-none">Terms of Service</a> and <a asp-controller="Home" asp-action="Privacy" class="text-decoration-none">Privacy Policy</a>
                    </label>
                </div>

                <div class="d-grid mb-3">
                    <button type="submit" class="btn btn-primary rounded-3" id="submitBtn">Create Account</button>
                </div>

                <p class="text-center text-muted mb-0">
                    Already have an account?
                    <a asp-controller="Login" asp-action="Index" class="text-decoration-none fw-semibold">Login</a>
                </p>
            </form>
        </div>
    </div>
</div>

<style>
    #submitBtn.btn-blocked {
        background-color: #0b1826;
        border-color: #0b1826;
        opacity: 0.6;
        cursor: not-allowed;
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        (function() {
            const form = document.getElementById('registerForm');
            const submitBtn = document.getElementById('submitBtn');
            const checkbox = document.getElementById('privacyPolicy');

            const rules = {
                FirstName: v => v.trim().length > 0,
                LastName: v => v.trim().length > 0,
                Email: v => /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(v.trim()),
                PhoneNumber: v => v.trim().length > 0,
                Password: v => v.length >= 8,
                ConfirmPassword: v => v.length > 0 && v === form.querySelector('[name="Password"]').value
            };

            const inputs = {};
            Object.keys(rules).forEach(name => {
                inputs[name] = form.querySelector(`[name="${name}"]`);
            });

            function validateField(name, showFeedback) {
                const el = inputs[name];
                const isValid = rules[name](el.value);
                el.classList.toggle('is-invalid', showFeedback && !isValid);
                return isValid;
            }

            function allValid() {
                const fieldsValid = Object.keys(rules).every(name => rules[name](inputs[name].value));
                return fieldsValid && checkbox.checked;
            }

            function updateButtonState() {
                const valid = allValid();
                submitBtn.classList.toggle('btn-blocked', !valid);
            }

            Object.keys(rules).forEach(name => {
                const el = inputs[name];

                el.addEventListener('input', () => {
                    if (el.classList.contains('is-invalid')) {
                        validateField(name, true);
                    }
                    if (name === 'Password') {
                        validateField('ConfirmPassword', inputs.ConfirmPassword.classList.contains('is-invalid'));
                    }
                    updateButtonState();
                });

                el.addEventListener('blur', () => {
                    validateField(name, true);
                    updateButtonState();
                });
            });

            checkbox.addEventListener('change', updateButtonState);

            form.addEventListener('submit', (e) => {
                if (!allValid()) {
                    e.preventDefault();
                    Object.keys(rules).forEach(name => validateField(name, true));
                    const firstInvalid = form.querySelector('.is-invalid');
                    if (firstInvalid) firstInvalid.focus();
                }
            });

            updateButtonState();
        })();
    </script>
}