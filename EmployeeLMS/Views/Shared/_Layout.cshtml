<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EmployeeLMS</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EmployeeLMS.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <style>
            :root {
                --bs-primary: #12263a;
                --bs-primary-rgb: 18, 38, 58;
                --bs-secondary: #7ebdc3;
                --bs-secondary-rgb: 126, 189, 195;
            }

            .btn-primary {
                --bs-btn-bg: #12263a;
                --bs-btn-border-color: #12263a;
                --bs-btn-color: #fff;
                --bs-btn-hover-bg: #0b1826;
                --bs-btn-hover-border-color: #0b1826;
                --bs-btn-hover-color: #fff;
                --bs-btn-active-bg: #0b1826;
                --bs-btn-active-border-color: #0b1826;
                --bs-btn-focus-shadow-rgb: 18, 38, 58;
            }

            .btn-outline-primary {
                --bs-btn-color: #12263a;
                --bs-btn-border-color: #12263a;
                --bs-btn-hover-bg: #12263a;
                --bs-btn-hover-border-color: #12263a;
                --bs-btn-hover-color: #fff;
            }

            .btn-secondary {
                --bs-btn-bg: #7ebdc3;
                --bs-btn-border-color: #7ebdc3;
                --bs-btn-color: #12263a;
                --bs-btn-hover-bg: #67aab1;
                --bs-btn-hover-border-color: #67aab1;
                --bs-btn-hover-color: #12263a;
                --bs-btn-active-bg: #67aab1;
                --bs-btn-active-border-color: #67aab1;
            }

            .btn-outline-secondary {
                --bs-btn-color: #4c8b91;
                --bs-btn-border-color: #7ebdc3;
                --bs-btn-hover-bg: #7ebdc3;
                --bs-btn-hover-border-color: #7ebdc3;
                --bs-btn-hover-color: #12263a;
            }

            .text-primary {
                color: #12263a !important;
            }

            .bg-primary {
                background-color: #12263a !important;
            }

            .text-secondary {
                color: #4c8b91 !important;
            }

            .bg-secondary {
                background-color: #7ebdc3 !important;
            }

            .navbar-nav .nav-link:hover {
                background-color: #f8f9fa;
            }
    </style>
</head>
<body>
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1080">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="toast align-items-center text-bg-success border-0 show" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="4000" id="successToast">
                <div class="d-flex">
                    <div class="toast-body">
                        @TempData["SuccessMessage"]
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="toast align-items-center text-bg-danger border-0 show" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="4000" id="errorToast">
                <div class="d-flex">
                    <div class="toast-body">
                        @TempData["ErrorMessage"]
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        }

    </div>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom shadow-sm py-2">
            <div class="container-fluid px-4">
                <a class="navbar-brand fw-bold fs-4 text-dark d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-book-half text-primary"></i>
                    EmployeeLMS
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 gap-2 ms-3">
                        <li class="nav-item">
                            <a class="nav-link text-dark px-3 rounded-3" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark px-3 rounded-3" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>
                    <div class="d-flex gap-2">
                        <a class="btn btn-primary rounded-3 px-4" asp-controller="Login" asp-action="">Login</a>
                        <a class="btn btn-secondary rounded-3 px-4" asp-controller="Register" asp-action="">Register</a>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid bg-light">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - EmployeeLMS - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
            document.addEventListener('DOMContentLoaded', function() {
                var toastElList = document.querySelectorAll('.toast');
                toastElList.forEach(function(toastEl) {
                    var toast = new bootstrap.Toast(toastEl);
                    toast.show();
                });
            });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
