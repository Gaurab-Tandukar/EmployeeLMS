@{
    ViewData["Title"] = "Login";
}

<div class="d-flex align-items-center justify-content-center" style="min-height: calc(100vh - 56px - 60px);">
    <div class="card shadow-sm border-0 rounded-4 p-4" style="width: 100%; max-width: 420px;">
        <div class="card-body">
            <h1 class="h3 fw-bold mb-1">Welcome Back</h1>
            <p class="text-muted mb-4">Continue with Library Management System</p>

            <form asp-controller="Login" asp-action="Index" method="post" id="loginForm" novalidate>
                <div class="mb-3">
                    <label for="email" class="form-label">Email</label>
                    <input type="email" name="email" class="form-control rounded-3" id="email" placeholder="employee@gmail.com">
                    <div class="invalid-feedback">Enter a valid email address.</div>
                </div>

                <div class="mb-4">
                    <label for="password" class="form-label">Password</label>
                    <input type="password" name="password" class="form-control rounded-3" id="password" placeholder="*******">
                    <div class="invalid-feedback">Password is required.</div>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-dark rounded-3" id="submitBtn">Login</button>
                </div>
                <p class="text-center text-muted mb-0 mt-3">
                    Don't have an account?
                    <a asp-controller="Register" asp-action="Index" class="text-decoration-none fw-semibold">Register</a>
                </p>
            </form>
        </div>
    </div>
</div>

<style>
    #submitBtn.btn-blocked {
        background-color: #000;
        opacity: 0.6;
        cursor: not-allowed;
    }
</style>

@section Scripts {
    <script>
        (function() {
            const form = document.getElementById('loginForm');
            const submitBtn = document.getElementById('submitBtn');

            const rules = {
                email: v => /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(v.trim()),
                password: v => v.trim().length > 0
            };

            const inputs = {};
            Object.keys(rules).forEach(name => {
                inputs[name] = form.querySelector(`[name="${name}"]`);
            });

            function validateField(name, showFeedback) {
                const el = inputs[name];
                const isValid = rules[name](el.value);
                el.classList.toggle('is-invalid', showFeedback && !isValid);
                return isValid;
            }

            function allValid() {
                return Object.keys(rules).every(name => rules[name](inputs[name].value));
            }

            function updateButtonState() {
                submitBtn.classList.toggle('btn-blocked', !allValid());
            }

            Object.keys(rules).forEach(name => {
                const el = inputs[name];

                el.addEventListener('input', () => {
                    if (el.classList.contains('is-invalid')) {
                        validateField(name, true);
                    }
                    updateButtonState();
                });

                el.addEventListener('blur', () => {
                    validateField(name, true);
                    updateButtonState();
                });
            });

            form.addEventListener('submit', (e) => {
                if (!allValid()) {
                    e.preventDefault();
                    Object.keys(rules).forEach(name => validateField(name, true));
                    const firstInvalid = form.querySelector('.is-invalid');
                    if (firstInvalid) firstInvalid.focus();
                }
            });

            updateButtonState();
        })();
    </script>
}