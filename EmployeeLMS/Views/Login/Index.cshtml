@model EmployeeLMS.DTO.LoginDTO
@{
    ViewData["Title"] = "Login";
}

<div class="d-flex align-items-center justify-content-center" style="min-height: calc(100vh - 56px - 60px);">
    <div class="card shadow-sm border-0 rounded-4 p-4" style="width: 100%; max-width: 420px;">
        <div class="card-body">
            <h1 class="h3 fw-bold mb-1">Welcome Back</h1>
            <p class="text-muted mb-4">Continue with Library Management System</p>

            <form asp-controller="Login" asp-action="Index" method="post" id="loginForm" novalidate>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" class="form-control rounded-3" placeholder="employee@gmail.com">
                    <div class="invalid-feedback">Enter a valid email address.</div>
                </div>

                <div class="mb-4">
                    <label asp-for="Password" class="form-label">Password</label>
                    <input asp-for="Password" type="password" class="form-control rounded-3" placeholder="*******">
                    <div class="invalid-feedback">Password is required.</div>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-dark rounded-3" id="submitBtn">Login</button>
                </div>
                <p class="text-center text-muted mb-0 mt-3">
                    Don't have an account?
                    <a asp-controller="Register" asp-action="Index" class="text-decoration-none fw-semibold">Register</a>
                </p>
            </form>
        </div>
    </div>
</div>

<!-- Toast container -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1080;">
    <div id="backendToast" class="toast align-items-center border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body" id="backendToastBody"></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

<style>
    #submitBtn.btn-blocked {
        background-color: #000;
        opacity: 0.6;
        cursor: not-allowed;
    }

    #backendToast.text-bg-danger {
        background-color: #dc3545 !important;
        color: #fff;
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        (function() {
            const form = document.getElementById('loginForm');
            const submitBtn = document.getElementById('submitBtn');

            const rules = {
                Email: v => /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(v.trim()),
                Password: v => v.trim().length > 0
            };

            const inputs = {};
            Object.keys(rules).forEach(name => {
                inputs[name] = form.querySelector(`[name="${name}"]`);
            });

            function validateField(name, showFeedback) {
                const el = inputs[name];
                const isValid = rules[name](el.value);
                el.classList.toggle('is-invalid', showFeedback && !isValid);
                return isValid;
            }

            function allValid() {
                return Object.keys(rules).every(name => rules[name](inputs[name].value));
            }

            function updateButtonState() {
                submitBtn.classList.toggle('btn-blocked', !allValid());
            }

            Object.keys(rules).forEach(name => {
                const el = inputs[name];

                el.addEventListener('input', () => {
                    if (el.classList.contains('is-invalid')) {
                        validateField(name, true);
                    }
                    updateButtonState();
                });

                el.addEventListener('blur', () => {
                    validateField(name, true);
                    updateButtonState();
                });
            });

            form.addEventListener('submit', (e) => {
                if (!allValid()) {
                    e.preventDefault();
                    Object.keys(rules).forEach(name => validateField(name, true));
                    const firstInvalid = form.querySelector('.is-invalid');
                    if (firstInvalid) firstInvalid.focus();
                }
            });

            updateButtonState();
        })();

        // Backend message toast (invalid credentials, etc.)
        (function() {
            const errors = @Html.Raw(Json.Serialize(
                    ViewData.ModelState.IsValid ? null : ViewData.ModelState.Values
                            .SelectMany(v => v.Errors)
                            .Select(e => e.ErrorMessage)
                            .FirstOrDefault()
                            ));

            if (errors) {
                const toastEl = document.getElementById('backendToast');
                const toastBody = document.getElementById('backendToastBody');

                toastEl.classList.remove('text-bg-danger');
                toastEl.classList.add('text-bg-danger');
                toastBody.textContent = errors;

                const toast = new bootstrap.Toast(toastEl, { delay: 4000 });
                toast.show();
            }
        })();
    </script>
}