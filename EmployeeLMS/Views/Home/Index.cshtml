@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Employee Library Management System</p>
    @if (User.Identity.IsAuthenticated)
    {
        <form asp-controller="Category" asp-action="Index" method="post" class="d-inline">
            <button type="submit" class="btn btn-outline-secondary rounded-3 px-4">Category</button>
        </form>

        @if (User.IsInRole("Admin"))
        {
            <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-dark rounded-3 px-4 ms-2">Admin Panel</a>
        }
    }
    else
    {
        <p>Please <a asp-controller="Login" asp-action="Index">login</a> or <a asp-controller="Register" asp-action="Index">register</a>.</p>
    }
</div>